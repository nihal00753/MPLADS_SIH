# Database — Attach your Neon DB PostgreSQL connection string here:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cache / BullMQ Queue — Attach your Upstash Redis connection string here:
REDIS_URL="rediss://default:YOUR_UPSTASH_TOKEN@xyz.upstash.io:6379"

# Server configuration
PORT=5000
JWT_SECRET="mplads-super-secure-jwt-secret-key-2026-gov"

# ML Service Seam: set to false to connect directly to live FastAPI backend on port 8000
USE_MOCK_ML="false"
ML_SERVICE_URL="http://127.0.0.1:8000"
