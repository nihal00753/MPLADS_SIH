# Backend URL for API proxy rewrites (/api/:path* -> $BACKEND_URL/api/:path*)
# Example: https://mplads-backend.onrender.com or https://api.yourdomain.com
BACKEND_URL=http://127.0.0.1:5000

# Direct FastAPI ML / RAG service URL (optional fallback for /api/ml/nl-query)
# Example: https://mplads-ai.onrender.com
FASTAPI_URL=http://127.0.0.1:8000
